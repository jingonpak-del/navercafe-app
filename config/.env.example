NAVER_ID=
NAVER_PW=
# Optional local key used to encode persisted Naver cookies under data/session/.
NAVER_SESSION_KEY=
# Login stability options. "undetected" requires optional deps: undetected-chromedriver, pyperclip, curl-cffi.
NAVER_LOGIN_DRIVER=selenium
NAVER_LOGIN_INPUT_METHOD=auto
NAVER_KEEP_LOGIN=true
NAVER_USE_CURL_CFFI=true
NAVER_LOGIN_PROFILE_DIR=data/chrome-profile/naver-login
# Comma-separated cafe URLs to visit after login before cookies are saved.
NAVER_LOGIN_WARMUP_URLS=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_URL=
GOOGLE_DRIVE_FOLDER_ID=
